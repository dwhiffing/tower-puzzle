{
  "name": "tower-puzzle",
  "description": "A Phaser 3 TypeScript template using Vite.",
  "version": "1.3.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwhiffing/tower-puzzle.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/dwhiffing/tower-puzzle/issues"
  },
  "homepage": "https://github.com/dwhiffing/tower-puzzle#readme",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "deploy": "pnpm run build && gh-pages -d dist --nojekyll",
    "package": "pnpm run build && zip -r dist.zip dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "packageManager": "pnpm@9.15.0+sha1.8bfdb6d72b4d5fdf87d21d27f2bfbe2b21dd2629"
}
